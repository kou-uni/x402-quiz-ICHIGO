# ─── Optimism / contract ─────────────────────────────────────────
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ICHIGO_CONTRACT=0x836700463Dce76D9Cc3CDf6F6EDF946312c01869
ICHIGO_DECIMALS=18

# ─── Treasury (server-only — never expose to browser) ────────────
TREASURY_PRIVATE_KEY=
TREASURY_ADDRESS=0xEFFdE47EaD5CEE9d19f20Bdf5210664e9F08c4Ba

# ─── Token economics (human-readable, multiplied by 10^decimals) ─
DEPOSIT_AMOUNT=100
REWARD_AMOUNT=500

# ─── Quest ───────────────────────────────────────────────────────
# URL に ?q=<id> 指定が無いときのデフォルト Quest ID
DEFAULT_QUEST_ID=q-survey-001
# 後方互換のため SURVEY_ID も読みます
SURVEY_ID=q-survey-001

# ─── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Admin / Hermes Bearer 認証 ──────────────────────────────────
# /api/admin/quests/* を叩くために必要。Hermes 統合時はこの 1 トークンを Hermes 側に渡す。
# ランダムな長文字列を生成して設定: openssl rand -base64 32
ADMIN_TOKEN=

# ─── Admin Dashboard (/admin) ────────────────────────────────────
# /admin の human ログインに使うパスワード。Bearer token とは別。
# 推奨: openssl rand -base64 24
ADMIN_PASSWORD=

# ─── Vercel KV (Upstash) ─────────────────────────────────────────
# Provision a KV store in the Vercel dashboard, then paste the values.
# When unset, the server falls back to in-memory storage (dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_URL=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Public (browser-visible) ────────────────────────────────────
NEXT_PUBLIC_TREASURY_ADDRESS=0xEFFdE47EaD5CEE9d19f20Bdf5210664e9F08c4Ba
NEXT_PUBLIC_ICHIGO_CONTRACT=0x836700463Dce76D9Cc3CDf6F6EDF946312c01869
NEXT_PUBLIC_DEPOSIT_AMOUNT=100
NEXT_PUBLIC_REWARD_AMOUNT=500
NEXT_PUBLIC_CHAIN_ID=10

# ─── WalletConnect (optional — get a projectId at cloud.walletconnect.com) ─
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
